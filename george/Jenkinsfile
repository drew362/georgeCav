pipeline {
    agent any

    tools {
        maven 'Maven 3.9'
        jdk 'Java 17'
    }

    stages {
        stage('Сборка и запуск автотестов') {
            steps {
                dir('george') {
                    sh 'mvn clean test -Dspring.datasource.url=jdbc:postgresql://172.17.0.1:5432/Search2'
                }
            }
        }
    }

    post {
        always {
            allure includeProperties: false,
                    jdk: '',
                    properties: [],
                    reportBuildPolicy: 'ALWAYS',
                    results: [[path: 'george/target/allure-results']]
        }
    }
}
