pipeline {
    agent any

    tools {
        maven 'Maven 3.9'
        jdk 'Java 17'
    }

    stages {
        stage('Запуск автотестов') {
            steps {
                dir('george') {
                    sh "mvn clean test -Dspring.profiles.active=test -Dyandex.cloud.s3.access-key=${params.S3_KEY} -Dyandex.cloud.s3.secret-key=${params.S3_SECRET}"
                }
            }
        }
    }

    post {
        always {
            // 1. Генерируем Allure Report по результатам тестов H2
            allure includeProperties: false,
                    jdk: '',
                    properties: [],
                    reportBuildPolicy: 'ALWAYS',
                    results: [[path: 'george/target/surefire-reports']]

            withCredentials([string(credentialsId: 'max_bot_token', variable: 'MAX_TOKEN')]) {
                sh """
                    curl -k -s -X POST "https://platform-api2.max.ru/messages" \
                    -H "Authorization: \$MAX_TOKEN" \
                    -d "chat_id=13956800" \
                    -d "text=🚀 Автотесты Aquilon завершены!%0A%0AСтатус: ${currentBuild.currentResult}%0AСборка: #${env.BUILD_NUMBER}%0A%0A🔗 Отчет Allure: ${env.BUILD_URL}allure/"
                """
            }
        }
    }




}
