pipeline {
    agent any

    tools {
        maven 'Maven 3.9'
        jdk 'Java 17'
    }

    stages {
        stage('Запуск автотестов') {
            steps {
                dir('george') {
                    // Просто запускаем тесты без всяких агентов
                    sh 'mvn clean test'
                }
            }
        }
    }

    post {
        always {
            // Jenkins сам соберёт стандартные результаты тестов JUnit и покажет графики
            junit 'george/target/surefire-reports/*.xml'
        }
    }
}
