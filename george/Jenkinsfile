pipeline {
    agent any

    tools {
        maven 'Maven 3.9'
        jdk 'Java 17'
    }

    stage('Сборка и запуск автотестов') {
        steps {
            dir('george') {

                withEnv(['SPRING_DATASOURCE_URL=jdbc:postgresql://172.17.0.1:5432/Search2']) {
                    sh 'mvn clean test'
                }
            }
        }
    }


    post {
        always {
            allure includeProperties: false,
            jdk: '',
            properties: [],
            reportBuildPolicy: 'ALWAYS',
            results: [[path: 'george/target/allure-results']]
        }
    }
}
