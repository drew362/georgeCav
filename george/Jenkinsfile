pipeline {
    agent any

    tools {
        maven 'Maven 3.9'
        jdk 'Java 17'
    }

    stages {
        stage('Запуск автотестов') {
            steps {
                dir('george') {
                    sh "mvn clean test -Dspring.profiles.active=test -Dyandex.cloud.s3.access-key=${params.S3_KEY} -Dyandex.cloud.s3.secret-key=${params.S3_SECRET}"
                }
            }
        }
    }

    post {
        always {
            // 1. Генерируем Allure Report
            allure includeProperties: false,
                    jdk: '',
                    properties: [],
                    reportBuildPolicy: 'ALWAYS',
                    results: [[path: 'george/target/surefire-reports']]

            // 2. Безопасно достаем токен из зашифрованного сейфа Jenkins
            withCredentials([string(credentialsId: 'telegram_bot_token', variable: 'TELEGRAM_TOKEN')]) {
                sh """
                curl -s -X POST "https://api.telegram.org/bot${TELEGRAM_TOKEN}/sendMessage" \
                -d "chat_id=196918542" \
                -d "parse_mode=HTML" \
                -d "text=🚀 <b>Автотесты Aquilon завершены!</b>%0A%0AСтатус: <b>${currentBuild.currentResult}</b>%0AСборка: #${env.BUILD_NUMBER}%0A%0A🔗 <a href='${env.BUILD_URL}allure/'>ОТКРЫТЬ ALLURE REPORT</a>"
            """
            }
        }
    }

}

