pipeline {
    agent any

    tools {
        maven 'Maven 3.9'
        jdk 'Java 17'
    }

    stages {
        stage('Запуск автотестов') {
            steps {
                dir('george') {
                    sh 'mvn clean test'
                }
            }
        }
    }

    post {
        always {
            // Jenkins берёт стандартные XML-отчёты и сам строит из них красивый Allure!
            allure includeProperties: false,
                    jdk: '',
                    properties: [],
                    reportBuildPolicy: 'ALWAYS',
                    results: [[path: 'george/target/surefire-reports']]
        }
    }
}
