# Шаг 1: Берем готовый образ с Java 17 (или вашей версией)
FROM eclipse-temurin:17-jre-alpine

# Шаг 2: Указываем рабочую папку внутри контейнера
WORKDIR /app

# Шаг 3: Копируем скомпилированный .jar файл внутрь контейнера
COPY target/george-*.jar app.jar

# Шаг 4: Открываем порт наружу
EXPOSE 8086

# Шаг 5: Команда для запуска приложения при старте контейнера
ENTRYPOINT ["java", "-jar", "app.jar"]
